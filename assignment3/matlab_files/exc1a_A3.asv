A_r = 1;
L_r = 1;
E_r = 1;
rao_r = 6;
M1 = 10;
M2 = 10;
alpha = 0.1;

M_lump = [10 0; 0 10];
M_rod = (A_r * L_r * rao_r) / 6 * [2 1; 1 2];
K_rod = (A_r * E_r) / L_r * [1 -1; -1 1];
C_rod = alpha * K_rod;

A = [0 0 1 0;
    0 0 0 1;
    -13/143 13/143 -1.3/143 1.3/143;
    13/143 -13/143 1.3/143 -1.3/143];
B = [0;0;12;-1];
C = [0 1 0 0];
D = 0;

sys = ss(A, B, C, D);
poles = eig(A);
zeros = tzero(sys);

sys_tf = tf(sys);
[num, den] = tfdata(sys_tf);

roots_den = roots(den);
disp(roots_den)
disp(pole)

